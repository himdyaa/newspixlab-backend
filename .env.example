# ---- NewsPixLab Service : zaroori keys (ye file kabhi GitHub par mat dalo) ----
# Server ka public URL (deploy ke baad), jaise https://service.newspixlab.com
BASE_URL=http://localhost:3000

# Razorpay : dashboard.razorpay.com -> Settings -> API Keys se milega
# Pehle TEST keys (rzp_test_...) se chalao, live hone par LIVE keys (rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=XXXX
# Webhook secret : Razorpay dashboard -> Settings -> Webhooks me banega
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth : Google Cloud Console -> APIs & Services -> Credentials
# Blogger API v3 "Enabled" honi chahiye; Authorized redirect URI me ye dalo:
#   <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=XXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=XXXX

# Session + service key (koi lambi random string rakho)
SESSION_SECRET=badlo-isse-lambi-random-string
SERVICE_KEY=badlo-isse-bhi-lambi-random-string
PORT=3000
